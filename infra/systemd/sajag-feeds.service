# Sajag AI tier — open Mumbai city feeds (air quality, heat, GDACS cyclones, rivers, USGS quakes, BMC notices) on 127.0.0.1:8199.
# Runs from the checkout's src with a host venv ($SAJAG_AI_VENV_DIR/ai-forecast, default $SAJAG_ROOT/.venvs/ai-forecast:
# fastapi, uvicorn, httpx, pydantic-settings, structlog — everything services/cityfeeds needs; see its README).
# Loopback only; the deck proxies /api/cityfeeds. Polite: every feed has a cache, a minimum interval and a daily cap.
# Pulled in by sajag-ai.target. Values come from ~/.config/sajag/sajag.env (SAJAG_FEEDS_* overrides, none secret).
[Unit]
Description=Sajag city feeds (air, heat, cyclones, rivers, quakes, notices) on 127.0.0.1:8199
PartOf=sajag-ai.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/sajag/sajag.env
ExecStart=/bin/bash -c 'cd "$SAJAG_ROOT/services/cityfeeds" && exec env PYTHONPATH=src PORT=8199 HOST=127.0.0.1 "$${SAJAG_AI_VENV_DIR:-$SAJAG_ROOT/.venvs}/ai-forecast/bin/python" -m cityfeeds'
Restart=always
RestartSec=5
TimeoutStopSec=30
# shared GB10 unified pool: an AI host is the kernel's preferred OOM victim, never the desktop session
OOMScoreAdjust=500
