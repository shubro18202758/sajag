# One-shot bring-up of the Sajag stack at boot (and on `systemctl --user start
# sajag.target`): waits for Docker, then runs scripts/sajag_up.sh --boot —
# compose up -d, migrations, seed-if-empty, and a convergence report in the
# journal (journalctl --user -u sajag-up). Model hosts are started by
# sajag-models.target alongside it. Installed by scripts/sajag_up.sh --install-units.
[Unit]
Description=Sajag stack bring-up: compose services, migrations, readiness report
PartOf=sajag.target
# retries (Restart= below) at most 10 an hour: a Docker wait that keeps
# timing out is retried indefinitely (≤6/h), a step failing fast and for
# good (a broken migration) stops after 10 and leaves the unit failed
StartLimitIntervalSec=1h
StartLimitBurst=10

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=%h/.config/sajag/sajag.env
ExecStart=/bin/bash ${SAJAG_ROOT}/scripts/sajag_up.sh --boot
# docker wait (≤10 min) + bring-up + convergence (decider cold load ≈5 min)
TimeoutStartSec=30min
# A bring-up step that failed (exit 3: Docker still unreachable after 10 min,
# compose, migrations, seed) or a timeout is retried. Not "not converged"
# (exit 1: everything is up and supervised, the journal has the readiness
# table) nor a preflight refusal (exit 2: needs the operator).
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=1 2
